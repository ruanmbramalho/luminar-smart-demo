---
import LuminarSmart from '../components/luminar-smart/LuminarSmart.astro';
import '../styles/global.css';
import '../styles/page.scss';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="description"
      content="Luminar Smart — uma demonstração de atendimento inteligente para seguros e benefícios."
    />
    <meta name="theme-color" content="#080a0c" />
    <meta name="application-name" content="Luminar Smart" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="apple-mobile-web-app-title" content="Luminar" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <title>Luminar Smart | Atendimento inteligente</title>
  </head>
  <body>
    <div class="ambient ambient--one"></div>
    <div class="ambient ambient--two"></div>
    <main>
      <nav class="topbar" aria-label="Principal">
        <a class="brand" href="/" aria-label="Luminar Gold — início">
          <span class="brand-symbol" aria-hidden="true"><i></i></span>
          <span><strong>Luminar</strong><small>Gold</small></span>
        </a>
        <div class="topbar-actions">
          <button class="install-button" id="install-app" type="button" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 17v3h14v-3"></path>
            </svg>
            <span id="install-label">Instalar app</span>
          </button>
          <span class="concept-badge"><i></i> Protótipo conceitual</span>
        </div>
      </nav>

      <section class="hero">
        <div class="eyebrow"><span></span> Inteligência que aproxima</div>
        <h1>O futuro do atendimento<br />da Luminar, <em>agora.</em></h1>
        <p>
          Uma experiência inteligente que entende necessidades, qualifica
          oportunidades e aproxima cada cliente do especialista certo.
        </p>
      </section>

      <div id="atendimento"><LuminarSmart /></div>

      <section class="value-strip" aria-label="Benefícios">
        <div>
          <span>01</span><p>
            <strong>Atendimento contínuo</strong>Disponível quando o cliente
            precisar
          </p>
        </div>
        <div>
          <span>02</span><p>
            <strong>Menos atrito</strong>Uma conversa simples e natural
          </p>
        </div>
        <div>
          <span>03</span><p>
            <strong>Leads mais preparados</strong>Contexto comercial antes do
            contato
          </p>
        </div>
      </section>
    </main>
    <footer>
      <p>
        <strong>Demonstração conceitual.</strong> Informações e condições de seguros
        devem ser confirmadas por um corretor habilitado.
      </p>
      <span>© 2026 Luminar Gold</span>
    </footer>
    <dialog
      class="ios-install-dialog"
      id="ios-install-dialog"
      aria-labelledby="ios-install-title"
    >
      <button
        class="ios-install-dialog__close"
        id="close-ios-install"
        type="button"
        aria-label="Fechar">×</button
      >
      <div class="ios-install-dialog__mark" aria-hidden="true">L</div>
      <div>
        <span class="ios-install-dialog__eyebrow">Instalar Luminar Smart</span>
        <h2 id="ios-install-title">Adicionar à Tela de Início</h2>
        <p
          class="ios-install-dialog__browser-note"
          id="ios-browser-note"
          hidden
        >
          No iPhone, abra este endereço no Safari para instalar o aplicativo.
        </p>
        <ol>
          <li>Toque no botão <strong>Compartilhar</strong> do navegador.</li>
          <li>
            Role o menu e escolha <strong>Adicionar à Tela de Início</strong>.
          </li>
          <li>Confirme tocando em <strong>Adicionar</strong>.</li>
        </ol>
      </div>
    </dialog>
    <script>
      interface InstallPromptEvent extends Event {
        prompt(): Promise<void>;
        userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>;
      }

      type NavigatorWithStandalone = Navigator & { standalone?: boolean };

      const installButton =
        document.querySelector<HTMLButtonElement>('#install-app');
      const installLabel =
        document.querySelector<HTMLElement>('#install-label');
      const iosInstallDialog = document.querySelector<HTMLDialogElement>(
        '#ios-install-dialog',
      );
      const iosBrowserNote =
        document.querySelector<HTMLElement>('#ios-browser-note');
      const closeIosInstall =
        document.querySelector<HTMLButtonElement>('#close-ios-install');
      const isIos =
        /iPad|iPhone|iPod/i.test(navigator.userAgent) ||
        (/Macintosh/i.test(navigator.userAgent) &&
          navigator.maxTouchPoints > 1);
      const isSafari =
        /Safari/i.test(navigator.userAgent) &&
        !/CriOS|FxiOS|EdgiOS|OPiOS/i.test(navigator.userAgent);
      const isStandalone =
        window.matchMedia('(display-mode: standalone)').matches ||
        Boolean((navigator as NavigatorWithStandalone).standalone);
      let installPrompt: InstallPromptEvent | null = null;

      if (isIos && !isStandalone) {
        installButton?.removeAttribute('hidden');
        if (installLabel) installLabel.textContent = 'Adicionar à tela';
        if (iosBrowserNote) iosBrowserNote.hidden = isSafari;
      }

      window.addEventListener('beforeinstallprompt', (event) => {
        event.preventDefault();
        installPrompt = event as InstallPromptEvent;
        installButton?.removeAttribute('hidden');
      });

      installButton?.addEventListener('click', async () => {
        if (installPrompt) {
          await installPrompt.prompt();
          await installPrompt.userChoice;
          installPrompt = null;
          installButton.hidden = true;
          return;
        }
        if (isIos && !isStandalone) iosInstallDialog?.showModal();
      });

      closeIosInstall?.addEventListener('click', () =>
        iosInstallDialog?.close(),
      );
      iosInstallDialog?.addEventListener('click', (event) => {
        if (event.target === iosInstallDialog) iosInstallDialog.close();
      });

      window.addEventListener('appinstalled', () => {
        installPrompt = null;
        if (installButton) installButton.hidden = true;
      });

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          void navigator.serviceWorker.register('/sw.js');
        });
      }
    </script>
  </body>
</html>
