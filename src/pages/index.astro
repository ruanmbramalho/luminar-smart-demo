---
import LuminarSmart from '../components/luminar-smart/LuminarSmart.astro';
import '../styles/global.css';
import '../styles/page.scss';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Luminar Smart — uma demonstração de atendimento inteligente para seguros e benefícios." />
    <meta name="theme-color" content="#080a0c" />
    <title>Luminar Smart | Atendimento inteligente</title>
  </head>
  <body>
    <div class="ambient ambient--one"></div>
    <div class="ambient ambient--two"></div>
    <main>
      <nav class="topbar" aria-label="Principal">
        <a class="brand" href="/" aria-label="Luminar Gold — início">
          <span class="brand-symbol" aria-hidden="true"><i></i></span>
          <span><strong>Luminar</strong><small>Gold</small></span>
        </a>
        <span class="concept-badge"><i></i> Protótipo conceitual</span>
      </nav>

      <section class="hero">
        <div class="eyebrow"><span></span> Inteligência que aproxima</div>
        <h1>O futuro do atendimento<br />da Luminar, <em>agora.</em></h1>
        <p>Uma experiência inteligente que entende necessidades, qualifica oportunidades e aproxima cada cliente do especialista certo.</p>
      </section>

      <LuminarSmart />

      <section class="value-strip" aria-label="Benefícios">
        <div><span>01</span><p><strong>Atendimento contínuo</strong>Disponível quando o cliente precisar</p></div>
        <div><span>02</span><p><strong>Menos atrito</strong>Uma conversa simples e natural</p></div>
        <div><span>03</span><p><strong>Leads mais preparados</strong>Contexto comercial antes do contato</p></div>
      </section>
    </main>
    <footer>
      <p><strong>Demonstração conceitual.</strong> Informações e condições de seguros devem ser confirmadas por um corretor habilitado.</p>
      <span>© 2026 Luminar Gold</span>
    </footer>
  </body>
</html>
