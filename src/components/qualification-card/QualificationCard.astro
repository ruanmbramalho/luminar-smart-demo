---
import './QualificationCard.scss';
---

<template id="qualification-template">
  <article class="qualification" aria-label="Análise Luminar Smart">
    <header class="qualification__header">
      <span class="qualification__icon" aria-hidden="true">✦</span>
      <div>
        <small>Qualificação concluída</small>
        <h3>Análise Luminar Smart</h3>
      </div>
    </header>
    <dl class="qualification__grid"></dl>
    <div class="qualification__summary">
      <span>Resumo para o especialista</span>
      <p></p>
    </div>
    <p class="qualification__next">
      Próximo passo sugerido: avaliação por um especialista Luminar.
    </p>
  </article>
</template>
